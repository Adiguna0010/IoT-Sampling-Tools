{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/predict",
      "destination": "/api/predict.py"
    },
    {
      "source": "/api/predict/(.*)",
      "destination": "/api/predict.py"
    },
    {
      "source": "/api/ai-health",
      "destination": "/api/health.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/server.js"
    }
  ]
}
