{
  "rewrites": [
    {
      "source": "/api/predict",
      "destination": "/api/predict.py"
    },
    {
      "source": "/api/predict/(.*)",
      "destination": "/api/predict.py"
    },
    {
      "source": "/api/data/latest",
      "destination": "/api/server"
    },
    {
      "source": "/api/data/latest/(.*)",
      "destination": "/api/server"
    },
    {
      "source": "/api/data/history/(.*)",
      "destination": "/api/server"
    },
    {
      "source": "/api/schedules/(.*)",
      "destination": "/api/server"
    },
    {
      "source": "/api/schedules",
      "destination": "/api/server"
    },
    {
      "source": "/api/commands",
      "destination": "/api/server"
    }
  ]
}
